<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvTermsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Términos y Condiciones"
        android:textSize="@dimen/text_section_header"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/spacing_lg" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvTermsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseTerms"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_secondary"
        android:text="Cerrar"
        android:textSize="@dimen/text_button_secondary"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/spacing_lg"
        android:contentDescription="Cerrar términos y condiciones" />

</LinearLayout>