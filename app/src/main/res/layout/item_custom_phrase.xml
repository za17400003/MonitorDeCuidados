<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_xs"
    android:minHeight="@dimen/touch_target_secondary"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/tvPhraseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Frase personalizada"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnPlayPhrase"
            android:layout_width="@dimen/touch_target_icon"
            android:layout_height="@dimen/touch_target_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_plus"
            android:contentDescription="Reproducir frase"
            app:tint="@color/primary" />

        <ImageButton
            android:id="@+id/btnDeletePhrase"
            android:layout_width="@dimen/touch_target_icon"
            android:layout_height="@dimen/touch_target_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_trash"
            android:contentDescription="Eliminar frase"
            app:tint="@color/status_error" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>