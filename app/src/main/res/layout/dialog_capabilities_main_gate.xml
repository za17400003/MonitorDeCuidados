<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Evaluación Inicial"
        android:textSize="@dimen/text_section_header"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <TextView
        android:id="@+id/tvDialogBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="¿Desea realizar la evaluación de capacidades ahora? Esto nos ayudará a configurar el dispositivo de forma óptima."
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_secondary" />

    <Button
        android:id="@+id/btnDoAssessment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_primary"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="Hacer Evaluación"
        android:textSize="@dimen/text_button_primary"
        android:textAllCaps="false"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:contentDescription="Iniciar evaluación de capacidades" />

    <Button
        android:id="@+id/btnSkipAssessment"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_primary"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="OMITIR"
        android:textSize="@dimen/text_button_primary"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        app:strokeColor="@color/primary"
        android:contentDescription="Omitir evaluación" />

    <Button
        android:id="@+id/btnCancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_primary"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="Cancelar"
        android:textSize="@dimen/text_button_secondary"
        android:textAllCaps="false"
        android:textColor="@color/text_hint"
        android:contentDescription="Cancelar" />

</LinearLayout>